load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//tools:versioned_py_wheel.bzl", "multi_version_py_wheel")

FIM_VERSION = "0.1.2"
# Platform-specific compatibility - supports Linux, macOS, and Windows.
COMPATIBLE_TARGETS = select({
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Platform-specific wheel tags (PEP 425).
WHEEL_PLATFORM = select({
    "//platforms:is_linux_x86_64": "manylinux2014_x86_64",
    "//platforms:is_linux_arm64": "manylinux2014_aarch64",
    "//platforms:is_darwin_aarch64": "macosx_11_0_arm64",
    "//platforms:is_darwin_x86_64": "macosx_10_9_x86_64",
    "//platforms:is_windows_x86_64": "win_amd64",
    "//platforms:is_windows_arm64": "win_arm64",
    "//conditions:default": "any",
})

# Copy extension to correct package location for wheel distribution.
genrule(
    name = "copy_extension_so",
    srcs = ["//src/python:_fim"],
    outs = ["fim/_fim.so"],
    cmd = "cp $< $@",
)

genrule(
    name = "copy_extension_pyd",
    srcs = ["//src/python:_fim"],
    outs = ["fim/_fim.pyd"],
    cmd = "cp $< $@",
)

py_library(
    name = "fim",
    srcs = [
        "fim/__init__.py",
        "fim/_fim.pyi",
    ] + select({
        "@platforms//os:windows": [":copy_extension_pyd"],
        "//conditions:default": [":copy_extension_so"],
    }),
    imports = ["."],
    visibility = ["//visibility:public"],
)

# ==============================================================================
# Python Wheel Distribution
# ==============================================================================
# multi_version_py_wheel applies a Starlark configuration transition per
# Python version, ensuring native extensions are compiled against the matching
# Python headers.

PYTHON_VERSIONS = {
    "3.10": "cp310",
    "3.11": "cp311",
    "3.12": "cp312",
    "3.13": "cp313",
    "3.14": "cp314",
}

multi_version_py_wheel(
    author = "AI for Oncology Research Group",
    default_version = "3.11",
    distribution = "fimage-python",
    homepage = "https://github.com/NKI-AI/fimage",
    license = "Apache-2.0",
    name_prefix = "fim_wheel",
    platform = WHEEL_PLATFORM,
    python_requires = ">=3.10",
    python_versions = PYTHON_VERSIONS,
    requires = [
        "numpy",
    ],
    strip_path_prefixes = ["python"],
    summary = "Fast Image processing library with lazy evaluation",
    target_compatible_with = COMPATIBLE_TARGETS,
    version = FIM_VERSION,
    deps = [":fim"],
)
